local vars = { signupuser = "", signuppass = "", loginuser = "", loginpass = "", key = "", metadata = {
    created_day = os.date("%A"),
    created_time = os.date("%I:%M:%S %p"),
    created_date = os.date("%m/%d/%Y"),
    logged_in = false
} }

local function save_metadata()
    vars.metadata.current_user = vars.loginuser
end

--login
local login_box = tab:CreateGroupbox({ Name = "Login", Column = 2 }, "INDEX")
login_box:CreateInput({
    Name = "Username",
    Icon = Icons:GetIcon('text-cursor-input', 'Lucide'),
    CurrentValue = vars.loginuser or "",
    PlaceholderText = "Enter username",
    Enter = true,
    Callback = function(text) vars.loginuser = text end
}, "INDEX")
login_box:CreateInput({
    Name = "Password",
    Icon = Icons:GetIcon('text-cursor-input', 'Lucide'),
    CurrentValue = vars.loginpass or "",
    PlaceholderText = "Enter password",
    Enter = true,
    Callback = function(text) vars.loginpass = text end
}, "INDEX")
login_box:CreateButton({
    Name = "Login",
    Icon = Icons:GetIcon('check', 'Material'),
    Callback = function()
        if vars.loginuser == "" or vars.loginpass == "" then
            UI:Notification({ Title = "Login Failed", Icon = Icons:GetIcon('error', 'Material'), Content = "Please enter both username and password." }, "INDEX")
            return
        end
        local ok_api, resp = api("login", vars.loginuser, vars.loginpass)
        if ok_api and resp and resp.success then
            if isfolder(ACCOUNTS) then
                for _, file in ipairs(listfiles(ACCOUNTS)) do
                    if file:sub(-5) == ".json" then
                        local raw = readfile(file)
                        local ok, dec = pcall(function() return HttpService:JSONDecode(raw) end)
                        if ok and dec and dec.metadata then
                            dec.metadata.logged_in = false
                            writefile(file, HttpService:JSONEncode(dec))
                        end
                    end
                end
            end
            vars.metadata.logged_in = true
            save_metadata()
            save_account_file(vars.loginuser, vars.loginpass, vars.metadata)

            UI:Notification({ Title = "Login Success", Icon = Icons:GetIcon('check_circle', 'Material'), Content = resp.msg or ("Welcome " .. vars.loginuser) }, "INDEX")
        else
            vars.metadata.logged_in = false
            save_metadata()
            UI:Notification({ Title = "Login Failed", Icon = Icons:GetIcon('error', 'Material'), Content = (resp and (resp.error or resp.msg)) or "Invalid username or password." }, "INDEX")
        end
    end
}, "INDEX")

