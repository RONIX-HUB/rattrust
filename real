local BASE = "Galaxy Hub"
local USERDATA = BASE .. "/Userdata"
local ACCOUNTS = USERDATA .. "/Accounts"

if not isfolder(BASE) then makefolder(BASE) end
if not isfolder(USERDATA) then makefolder(USERDATA) end
if not isfolder(ACCOUNTS) then makefolder(ACCOUNTS) end

local function account_path(username)
    return ACCOUNTS .. "/" .. username .. ".json"
end

local function save_account_file(username, password, metadata)
    local ok, enc = pcall(function()
        return HttpService:JSONEncode({ username = username, password = password, metadata = metadata })
    end)
    if ok and enc then
        pcall(function() writefile(account_path(username), enc) end)
    end
end

local function request(data)
    data.Headers = data.Headers or {}
    data.Headers["Content-Type"] = "application/json"

    local function norm(r)
        if not r then return nil end
        local code = r.StatusCode or r.statusCode or r.status_code or r.status or 0
        local body = r.Body or r.body or r.data or r.content or ""
        return { status = code, body = body, ok = (code >= 200 and code < 300) }
    end

    if request then
        local ok, res = pcall(function()
            return request({
                Url = data.Url,
                Method = data.Method,
                Headers = data.Headers,
                Body = data.Body
            })
        end)
        if ok and res then return norm(res) end
    end

    if http_request then
        local ok, res = pcall(function()
            return http_request({
                Url = data.Url,
                Method = data.Method,
                Headers = data.Headers,
                Body = data.Body
            })
        end)
        if ok and res then return norm(res) end
    end
--sixsevenrat
    if syn and syn.request then
        local ok, res = pcall(function()
            return syn.request({
                Url = data.Url,
                Method = data.Method,
                Headers = data.Headers,
                Body = data.Body
            })
        end)
        if ok and res then return norm(res) end
    end

    --https request
    if http and http.request then
        local ok, res = pcall(function()
            return http.request({
                url = data.Url,
                method = data.Method,
                headers = data.Headers,
                body = data.Body
            })
        end)
        if ok and res then return norm(res) end
    end

    return nil
end

local function api(action, user, pass)
    local payload
    if action == "keycheck" then
        payload = { action = "keycheck", key = tostring(user or "") }
    else
        payload = { action = action, username = tostring(user or ""), password = tostring(pass or "") }
    end

    local ok_enc, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
    if not ok_enc then return false, { error = "json_encode_failed" } end

    local res = request({ Method = "POST", Url = worker_url, Headers = { ["Content-Type"] = "application/json" }, Body = encoded })
    if not res then return false, { error = "Failed to contact server" } end

    if not res.ok then
        local dec_ok, dec = pcall(function() return HttpService:JSONDecode(res.body) end)
        if dec_ok and type(dec) == "table" then return false, dec end
        return false, { error = "Server error: " .. tostring(res.status) }
    end

    local ok_dec, decoded = pcall(function() return HttpService:JSONDecode(res.body) end)
    if not ok_dec then return false, { error = "Invalid server response" } end

    return true, decoded
end

